{
  "version": 1,
  "name": "auth.forgotpassword",
  "summary": "Request reset code, generic reply (auth: none, rate-limited)",
  "method": "POST",
  "path": "/api/auth/forgot-password",
  "request": {
    "query": {},
    "params": {},
    "body": {
      "type": "object",
      "fields": {
        "email": {
          "type": "string",
          "optional": false,
          "format": "email"
        }
      },
      "name": "ForgotPasswordBody"
    }
  },
  "response": {
    "type": "object",
    "fields": {
      "message": {
        "type": "string",
        "optional": false
      }
    },
    "name": "ForgotPasswordResponse"
  },
  "errors": [
    {
      "status": 400,
      "code": "VALIDATION_ERROR"
    },
    {
      "status": 500,
      "code": "INTERNAL_ERROR"
    }
  ]
}
