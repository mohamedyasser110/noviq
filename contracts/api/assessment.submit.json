  "request": {
    "query": {},
    "params": {},
    "body": {
      "type": "object",
      "fields": {
        "name": {
          "type": "string",
          "optional": true
        },
        "email": {
          "type": "string",
          "optional": true
        },
        "company": {
          "type": "string",
          "optional": true
        },
        "answers": {
          "type": "object",
          "optional": false,
          "fields": {}
