          "type": "object",
          "optional": false,
          "fields": {}
        }
      },
      "name": "ContentKeyBody"
    }
  },
  "response": {
    "type": "object",
    "fields": {
      "key": {
        "type": "string",
        "optional": false
      },
      "message": {
        "type": "string",
        "optional": false
      },
      "fileWritten": {
        "type": "boolean",
        "optional": false
      }
    },
    "name": "ContentKeyUpdateResponse"
  },
  "errors": [
    {
      "status": 400,
