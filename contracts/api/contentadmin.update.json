{
  "version": 1,
  "name": "contentadmin.update",
  "summary": "Upsert one content key with per-key validation (auth: admin JWT)",
  "method": "PUT",
  "path": "/api/admin/content/{key}",
  "request": {
    "query": {},
    "params": {
      "key": {
        "type": "string",
        "optional": false
      }
    },
    "body": {
      "type": "object",
      "fields": {
