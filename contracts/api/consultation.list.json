{
  "version": 1,
  "name": "consultation.list",
  "summary": "List consultations, optional status filter (auth: admin JWT)",
  "method": "GET",
  "path": "/api/consultation",
  "request": {
    "query": {
      "status": {
        "type": "string",
        "optional": true,
        "enum": [
          "new",
          "contacted",
          "scheduled",
          "completed",
          "archived"
        ]
      },
      "limit": {
        "type": "integer",
        "optional": true,
        "default": 50
      },
      "offset": {
        "type": "integer",
        "optional": true,
        "default": 0
      }
    },
    "params": {},
    "body": null
  },
  "response": {
    "type": "array",
    "of": {
      "type": "object",
      "fields": {
        "id": {
          "type": "integer",
          "optional": false
        },
        "name": {
          "type": "string",
          "optional": false
        },
        "email": {
          "type": "string",
          "optional": false
        },
        "status": {
          "type": "string",
          "optional": false
        }
      }
    }
  },
  "errors": [
    {
      "status": 401,
      "code": "UNAUTHENTICATED"
    },
    {
      "status": 500,
      "code": "INTERNAL_ERROR"
    }
  ]
}
