# ============================================================
# NOVIQ — Production Environment Configuration Template
# Copy this file to .env before deploying:
#   cp .env.production.example .env
# ============================================================

# 1. Security & Secrets (GENERATE STRONG SECRETS FOR PRODUCTION)
JWT_SECRET=replace_with_a_secure_random_64_char_hex_string
ADMIN_PASSWORD=replace_with_a_strong_admin_password_2026
REVALIDATE_SECRET=replace_with_a_secure_shared_secret_string

# 2. Ports & Networking
BACKEND_PORT=4322
FRONTEND_PORT=4321
NEXT_PUBLIC_API_URL=http://localhost:4322
FRONTEND_URL=http://localhost:4321

# 3. Storage & Paths
DB_PATH=/app/data/noviq.db
UPLOADS_DIR=/app/uploads

# 4. Optional SMTP Email Notification Settings
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=postmaster@noviq.com
# SMTP_PASS=your-smtp-secret-password
# SMTP_FROM="Noviq Alerts" <alerts@noviq.com>
# NOTIFY_EMAIL=admin@noviq.com
