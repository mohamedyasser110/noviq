{
  "name": "noviq-frontend",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 4321",
    "build": "node --max-old-space-size=3584 ./node_modules/next/dist/bin/next build",
    "start": "next start --port 4321",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit",
    "test:unit": "node tests/content-overrides.test.cjs",
    "test:nav": "tsc -p tests/tsconfig.navtest.json && node tests/nav-admin.test.cjs",
    "test:social": "tsc -p tests/tsconfig.socialtest.json && node tests/social-handles.test.cjs",
    "test:i18n": "node tests/i18n-key-check.cjs",
    "test:routes": "node tests/verify-routes.cjs",
    "test:contact": "node tests/contact-proxy.test.cjs",
    "test:overrides": "node tests/override-runtime.test.cjs",
    "test:navbar": "node tests/navbar-cta-removed.test.cjs",
    "test:clients": "node tests/clients-marquee.test.cjs",
    "test:resources": "node tests/resources-hub.test.cjs",
    "test:auth": "node tests/auth-session.test.cjs",
    "test:cleanup": "node tests/cleanup-test-contacts.cjs",
    "test:offline": "npm run type-check && npm run test:unit && npm run test:i18n && npm run test:nav && npm run test:social && npm run test:clients && npm run test:auth && npm run test:resources && npm run test:site-content && npm run test:text-integrity && npm run test:rich",
    "verify": "npm run test:offline && npm run test:routes && npm run test:contact && npm run test:overrides && npm run test:navbar",
    "verify:prod": "node scripts/verify-prod-build.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "postinstall": "",
    "test:site-content": "node tests/site-content.test.cjs",
    "test:text-integrity": "node tests/text-integrity.test.cjs",
    "test:rich": "node tests/resources-rich.test.cjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.1.2",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lucide-react": "^0.440.0",
    "motion": "^13.4.4",
    "next": "^15.5.27",
    "next-intl": "^3.26.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.5.2",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@playwright/test": "^1.47.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.11.0",
    "postcss": "^8.5.29",
    "prettier": "^3.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.0"
  },
  "overrides": {
    "source-map-js": "^1.2.2",
    "sharp": "^0.35.5",
    "postcss": "^8.5.29"
  }
}
