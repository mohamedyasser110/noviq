# ---------------------------------------------------------------------------
# Noviq frontend (Next.js) environment
# ---------------------------------------------------------------------------
# The Next.js app is a PURE UI — it talks to the Express backend in
# backend/ over HTTP. This variable is the single place that decides where.
# In development, the backend runs on http://127.0.0.1:4322 (PORT=4322 in
# backend/.env). COPY this file to .env.local and adjust to your machine.
#
# Empty value = same origin (production deploy where frontend & API share a
# domain). A bare http(s) origin = cross-origin (dev split, or a separate API
# host). Paths/queries/credentials are rejected by server.js.
NEXT_PUBLIC_API_URL=http://127.0.0.1:4322

# ---- Production / shared hosting ----
# Behind a reverse proxy that serves frontend + API from ONE domain,
# leave this EMPTY so the browser uses same-origin (no CORS involved):
# NEXT_PUBLIC_API_URL=
# With a separate API host, set the public API origin (no trailing slash):
# NEXT_PUBLIC_API_URL=https://api.noviq.com

# Optional: a server-only backend origin used by Server Actions / server-side
# fetches so the browser never sees the internal URL. Falls back to
# NEXT_PUBLIC_API_URL when unset.
# API_INTERNAL_URL=http://127.0.0.1:4322

# ---- On-demand revalidation (publishes a CMS edit on the FIRST refresh) ----
# The content pages are statically generated with a 120s ISR window as a safety
# net, but Next answers with the stale page first and rebuilds it in the
# background — so an admin's "save, then refresh" can show the old copy once.
# The backend pings POST /api/revalidate after every save, which drops the
# `noviq-cms` cache tag and makes the next visitor see the new copy at once.
#
# The secret must MATCH REVALIDATE_SECRET in backend/.env. Use a long random
# string. It is server-only: never prefix it with NEXT_PUBLIC_.
# When unset, /api/revalidate refuses every call (503) and the site simply
# keeps using the 120s window — nothing breaks, it is one refresh later.
# REVALIDATE_SECRET=change-me-to-a-long-random-string
