    "/imagegen": {
      "get": {
        "summary": "Generate an image via the server-side Pollinations proxy",
        "description": "The browser never contacts the upstream directly. The prompt is sanitised, then\nseveral model variants (flux, flux-realism, turbo, flux-anime) are tried in order\nuntil one returns a real image.\n\nContent policy: prompts requesting women/girls/females (English or Arabic) or unsafe\ncategories are rejected with 400. Rate limited to 1 request / 60s per IP by default\n(configurable via the `rl_imagegen` setting).",
        "tags": [
          "imagegen"
        ],
        "parameters": [
          {
            "name": "prompt",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Image description. Max 480 chars; 200 used after sanitising."
          },
          {
            "name": "seed",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Deterministic seed. Random when omitted."
          }
        ],
        "responses": {
          "200": {
            "description": "The generated image bytes.",
            "content": {
              "image/*": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "description": "Prompt missing, or blocked by the content policy.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentError"
                }
              }
            }
          },
          "429": {
            "description": "Image generation rate limit exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentError"
                }
              }
            }
          },
          "502": {
            "description": "Every upstream variant failed or timed out.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentError"
                }
              }
            }
          }
        }
      }
    },
