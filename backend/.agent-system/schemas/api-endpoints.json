    "/agent-bus/message": {
      "post": {
        "summary": "Send a message to the central agent message bus",
        "description": "Single entry point for agent coordination messages. Side effects are applied for\nAGENT_JOIN, AGENT_LEAVE, LOCK_ACQUIRE, LOCK_RELEASE, SCHEMA_UPDATED and\nERROR_REPORTED; every accepted message is appended to the event store and\nbroadcast on the /agent-bus/events SSE stream.\n\nNote: the REST /agent-bus/lock endpoint is an equivalent, more direct way to manage\nlocks; both paths now write to the event store.",
        "tags": [
          "agent-bus"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "type",
                  "source_agent",
                  "correlation_id",
                  "payload"
                ],
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "LOCK_ACQUIRE",
                      "LOCK_RELEASE",
                      "FILE_CHANGED",
                      "SCHEMA_UPDATED",
                      "AGENT_JOIN",
                      "AGENT_LEAVE",
                      "ERROR_REPORTED",
                      "SCHEMA_VERSION_REQUEST"
                    ]
                  },
                  "source_agent": {
                    "type": "string",
                    "description": "Agent sending the message."
                  },
                  "target_agent": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Optional intended recipient."
                  },
                  "correlation_id": {
                    "type": "string",
                    "description": "Caller-supplied id used to correlate the audit-trail entry."
                  },
                  "timestamp": {
                    "type": "string",
                    "description": "Optional ISO-8601 timestamp; defaults to now."
                  },
                  "payload": {
                    "type": "object",
                    "additionalProperties": true,
                    "description": "Type-specific body."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Message accepted and applied.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "message_id",
                    "event"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "accepted"
                      ]
                    },
                    "message_id": {
                      "type": "string",
                      "description": "Server-assigned id, e.g. m_<hex>."
                    },
                    "event": {
                      "type": "string",
                      "description": "Event type actually recorded (may differ from `type` for LOCK_*)."
                    },
                    "payload": {
                      "type": "object",
                      "additionalProperties": true,
                      "description": "Result data, e.g. { agentId }."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Missing required fields or unknown message type.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentError"
                }
              }
            }
          },
          "403": {
            "description": "LOCK_RELEASE with an invalid or expired lock token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentError"
                }
              }
            }
          },
          "404": {
            "description": "SCHEMA_UPDATED for an unknown resource.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentError"
                }
              }
            }
          },
          "409": {
            "description": "LOCK_ACQUIRE conflicting with an existing lock.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentError"
                }
              }
            }
          }
        }
      }
    },
    "/agent-bus/lock": {
      "post": {
        "summary": "Acquire, release, renew or inspect a file lock",
        "description": "The `action` query parameter selects the operation. Locks are advisory and shared\nacross the whole agent fleet; an exclusive lock blocks every other agent until it\nis released or its TTL expires. All successful operations are recorded in the event\nstore and broadcast on the SSE stream.",
        "tags": [
          "agent-bus"
        ],
        "parameters": [
          {
            "name": "action",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "acquire",
                "release",
                "renew",
                "status"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "file",
                  "agent"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "description": "Path being locked, relative to the project root."
                  },
                  "agent": {
                    "type": "string",
                    "description": "Agent requesting the operation."
                  },
                  "lock_type": {
                    "type": "string",
                    "enum": [
                      "shared",
                      "exclusive"
                    ],
                    "description": "Required for action=acquire."
                  },
                  "ttl_seconds": {
                    "type": "integer",
                    "description": "Requested TTL, clamped to the server minimum and maximum."
                  },
                  "reason": {
                    "type": "string",
                    "description": "Free-text justification, recorded in the audit trail."
                  },
                  "lock_token": {
                    "type": "string",
                    "description": "Required for action=release and action=renew."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "acquire -> { status:\"granted\", lock_token, expires_at } | release -> { status:\"released\" } | renew -> { status:\"renewed\" } | status -> lock status object.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/AgentLock"
                    },
                    {
                      "$ref": "#/components/schemas/AgentLockStatus"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Missing file/agent, invalid lock_type, missing lock_token, or unknown action.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentError"
                }
              }
            }
          },
          "403": {
            "description": "Invalid or expired lock token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentError"
                }
              }
            }
          },
          "409": {
            "description": "Lock conflict: another agent already holds a conflicting lock.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/AgentLock"
                    },
                    {
                      "$ref": "#/components/schemas/AgentError"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/agent-bus/schema/{resource}": {
      "get": {
        "summary": "Read a shared schema from the registry",
        "description": "The resource name is the schema filename without its `.json` suffix, e.g. `content`\nresolves to `.agent-system/schemas/content.json`.",
        "tags": [
          "agent-bus"
        ],
        "parameters": [
          {
            "name": "resource",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "content"
          }
        ],
        "responses": {
          "200": {
            "description": "Current schema envelope.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SchemaEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "No such resource.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentError"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Update a shared schema (lock-protected, optimistic concurrency)",
        "description": "Writes are cooperative: the caller must first hold a lock on `<resource>.json` and\nsend that `lock_token` in the body. Supplying `version` enables optimistic\nconcurrency — if the stored version differs, the write is rejected with 409 instead\nof clobbering a concurrent change. There is no `etag` query parameter; the etag in\nthe GET response is for change detection only.\n\nA versioned backup is written to `.agent-system/schemas/versions/`.",
        "tags": [
          "agent-bus"
        ],
        "parameters": [
          {
            "name": "resource",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "agent",
                  "lock_token",
                  "schema"
                ],
                "properties": {
                  "agent": {
                    "type": "string",
                    "description": "Agent performing the write."
                  },
                  "lock_token": {
                    "type": "string",
                    "description": "Token from a lock acquired on `<resource>.json`."
                  },
                  "version": {
                    "type": "string",
                    "description": "Expected current version. Mismatch -> 409 VERSION_CONFLICT."
                  },
                  "schema": {
                    "type": "object",
                    "additionalProperties": true,
                    "description": "Full replacement document."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Schema written.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "version",
                    "etag"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "updated"
                      ]
                    },
                    "version": {
                      "type": "string",
                      "description": "New version string."
                    },
                    "changed_at": {
                      "type": "string",
                      "description": "ISO-8601 write timestamp."
                    },
                    "etag": {
                      "type": "string",
                      "description": "md5 of the newly written content."
                    },
                    "notify_targets": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "Agents that should re-read the schema."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Missing agent, lock_token or schema.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentError"
                }
              }
            }
          },
          "403": {
            "description": "Lock token invalid, or it does not cover `<resource>.json` for this agent.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentError"
                }
              }
            }
          },
          "404": {
            "description": "No such resource.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentError"
                }
              }
            }
          },
          "409": {
            "description": "Version conflict.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentError"
                }
              }
            }
          }
        }
      }
    },
    "/agent-bus/events": {
      "get": {
        "summary": "Server-Sent Events stream of the agent event log",
        "description": "Opens a long-lived `text/event-stream`. On connect the last 100 events are replayed\nas `data: <json>` frames, then new events are streamed live. Comment frames\n(`: heartbeat`) are sent every 15s. The connection is never closed by the server.\n\nThis endpoint does NOT return JSON and never completes a normal request; do not\nassert on it as a JSON API.",
        "tags": [
          "agent-bus"
        ],
        "parameters": [
          {
            "name": "since",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Replay only events after this sequence number."
          },
          {
            "name": "filter",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Only stream events of this type."
          }
        ],
        "responses": {
          "200": {
            "description": "An open SSE stream.",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/agent-bus/agents": {
      "get": {
        "summary": "List agents currently registered on the bus",
        "tags": [
          "agent-bus"
        ],
        "responses": {
          "200": {
            "description": "Registered agents.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "agents"
                  ],
                  "properties": {
                    "agents": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/AgentInfo"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/agent-bus/health": {
      "get": {
        "summary": "Message bus health and registry sizes",
        "tags": [
          "agent-bus"
        ],
        "responses": {
          "200": {
            "description": "Bus is healthy.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "agents",
                    "schemas",
                    "locks"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "healthy"
                      ]
                    },
                    "uptime": {
                      "type": "number"
                    },
                    "agents": {
                      "type": "integer",
                      "description": "Number of registered agents."
                    },
                    "schemas": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "Known schema resource names."
                    },
                    "locks": {
                      "type": "integer",
                      "description": "Number of files currently locked."
                    },
                    "timestamp": {
                      "type": "string",
                      "description": "ISO-8601 timestamp."
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "AgentError": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "VALIDATION_ERROR",
                  "LOCK_CONFLICT",
                  "INVALID_TOKEN",
                  "SCHEMA_NOT_FOUND",
                  "VERSION_CONFLICT",
                  "RATE_LIMITED",
                  "UPSTREAM_ERROR"
                ]
              },
              "message": {
                "type": "string",
                "description": "Human-readable explanation."
              },
              "details": {
                "type": "object",
                "additionalProperties": true
              }
            }
          }
        }
      },
      "AgentLock": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "granted",
              "conflict",
              "released",
              "renewed"
            ]
          },
          "lock_token": {
            "type": "string",
            "description": "Opaque token proving lock ownership. Required to release or renew."
          },
          "expires_at": {
            "type": "string",
            "description": "ISO-8601 expiry timestamp."
          },
          "locked_by": {
            "type": "string",
            "description": "Agent currently holding the lock (on conflict)."
          },
          "wait_suggestion": {
            "type": "integer",
            "description": "Seconds to wait before retrying (on conflict)."
          }
        }
      },
      "AgentLockStatus": {
        "type": "object",
        "required": [
          "locked"
        ],
        "properties": {
          "locked": {
            "type": "boolean",
            "description": "Whether the file currently has any lock."
          },
          "lock_type": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "exclusive",
              "shared",
              null
            ]
          },
          "agent": {
            "type": "string",
            "description": "Holder of the exclusive lock."
          },
          "agents": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Holders when the lock is shared."
          },
          "expires_at": {
            "type": "string",
            "description": "ISO-8601 expiry timestamp."
          }
        }
      },
      "AgentInfo": {
        "type": "object",
        "required": [
          "id",
          "name",
          "capabilities"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Stable agent identifier (uuid)."
          },
          "name": {
            "type": "string",
            "description": "Unique agent name."
          },
          "joined_at": {
            "type": "string",
            "description": "ISO-8601 join timestamp."
          },
          "last_heartbeat": {
            "type": "string",
            "description": "ISO-8601 timestamp of the last heartbeat seen."
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Declared capabilities."
          }
        }
      },
      "SchemaEnvelope": {
        "type": "object",
        "required": [
          "resource",
          "version",
          "etag",
          "schema"
        ],
        "properties": {
          "resource": {
            "type": "string",
            "description": "Schema resource name (the file basename without .json)."
          },
          "version": {
            "type": "string",
            "description": "Opaque version string. Semver by convention, NOT a number."
          },
          "updated_at": {
            "type": "string",
            "description": "ISO-8601 timestamp of the last write."
          },
          "schema": {
            "type": "object",
            "additionalProperties": true
          },
          "etag": {
            "type": "string",
            "description": "16-char md5 of the raw file content. Use for change detection."
          }
        }
      }
    }
  }
}
