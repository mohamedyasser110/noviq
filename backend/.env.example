# ============================================================
# NOVIQ BACKEND — environment variables
# Copy to server/.env and edit, or set these in
# cPanel → Setup Node.js App → Environment Variables
# ============================================================

# API port (default 4322 locally; cPanel/Passenger injects PORT itself)
PORT=4322

# REQUIRED in production — long random string
JWT_SECRET=change-me-to-a-long-random-secret

# Admin panel password (username stays: admin)
ADMIN_PASSWORD=noviq2026

# Admin email (optional) — admin can sign in with username OR email
# ADMIN_EMAIL=admin@yourdomain.com

# Allowed frontend origins (comma-separated, no trailing slash).
# Locally the Next.js app runs on :4321.
# FRONTEND_URL=https://noviq.com,https://www.noviq.com

# ---- On-demand revalidation (publishes a CMS edit on the FIRST refresh) ----
# The frontend serves content pages from a static cache with a 120s ISR window
# as a safety net, but Next answers with the STALE page first and rebuilds in
# the background — so an admin's "save, then refresh" can still show the old
# copy once. After each save the backend pings the frontend's
# POST /api/revalidate, which drops its CMS cache tag.
#
# REVALIDATE_SECRET must MATCH the frontend's REVALIDATE_SECRET (.env.local).
# When it is missing the purge is skipped and the 120s window publishes the
# edit instead: nothing breaks, it is simply one refresh later.
# REVALIDATE_SECRET=change-me-to-a-long-random-string
#
# Origin of the Next app, no trailing slash (default: local dev port).
# FRONTEND_REVALIDATE_URL=http://127.0.0.1:4321

# API-only mode: set to false when the frontend is hosted
# separately (e.g. static files in public_html)
# SERVE_FRONTEND=false

# Custom paths (optional)
# DB_PATH=/home/USER/noviq-data/noviq.db
# FRONTEND_DIR=/home/USER/public_html
#
# Path resolution rules (organized, hosting-safe):
# - DB_PATH: SQLite file. The folder must exist + be writable.
# - FRONTEND_DIR: Next.js project root when co-hosted (default ../frontend).
#   Used for: content.config.js rebuild + i18n editor + upload location
#   detection. On static-only hosts set it to the served folder.
# - UPLOADS_DIR: explicit upload folder wins. Otherwise auto-detected:
#   <FRONTEND_DIR>/public/images/uploads when public/ exists (Next.js),
#   else <FRONTEND_DIR>/images/uploads (static export / public_html).
#   Public URL is always images/uploads/<file> on either origin.
# - Translations editor (admin → Translations) needs FRONTEND_DIR/i18n
#   to exist. On API-only hosts without a frontend checkout it answers
#   501 with guidance — edit the JSON in the frontend repo instead.
# UPLOADS_DIR=/home/USER/public_html/images/uploads

# ---- Backups (admin → Backup page + scheduled copies) ----
# Where server-side backup copies are stored. Defaults to <DB dir>/backups
# (same volume as the database on Railway). The admin history keeps the
# newest 10 and prunes the rest automatically.
# BACKUP_DIR=/home/USER/noviq-data/backups
# Automatic verified backup every N hours (same writer as downloads).
# 0 disables. First run is 2 minutes after boot, then on the interval.
# BACKUP_AUTO_HOURS=24

# NODE_ENV=production

# ---- Email notifications (optional; requires: npm install nodemailer) ----
# SMTP_HOST=mail.yourdomain.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=notify@yourdomain.com
# SMTP_PASS=your-smtp-password
# SMTP_FROM=notify@yourdomain.com
# NOTIFY_EMAIL=you@yourdomain.com
